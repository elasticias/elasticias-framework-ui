{
  "version": "0.2.0",
  "name": "comptoir.spacing",
  "note": "4-based spacing scale. Use semantic tokens (gutter/section/card) where possible; fall back to scale steps for one-off cases.",

  "base": "4px",

  "scale": {
    "0":  "0",
    "1":  "2px",
    "2":  "4px",
    "3":  "6px",
    "4":  "8px",
    "5":  "10px",
    "6":  "12px",
    "8":  "16px",
    "10": "20px",
    "12": "24px",
    "14": "28px",
    "16": "32px",
    "20": "40px",
    "24": "48px",
    "32": "64px"
  },

  "semantic": {
    "gutter":      "16px",
    "section":     "32px",
    "card":        "16px",
    "card-tight":  "12px",
    "field-gap":   "8px",
    "row-gap":     "10px",
    "page-pad-x":  "24px",
    "page-pad-y":  "20px"
  }
}
