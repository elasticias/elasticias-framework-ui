{
  "version": "0.2.0",
  "name": "comptoir.targets",
  "note": "Hit-target sizes. Default desktop dense rows use --hit (32px). Standard buttons use --hit-base. Mobile/POS bump up via .touch and .pos modifiers.",

  "hit": {
    "compact": "32px",
    "base":    "40px",
    "touch":   "48px",
    "pos":     "64px"
  },

  "minTouch": "48px",

  "fontSize": {
    "compact": "13px",
    "base":    "14px",
    "touch":   "15px",
    "pos":     "18px"
  },

  "breakpoints": {
    "mobile":  "(max-width: 767px)",
    "tablet":  "(min-width: 768px) and (max-width: 1279px)",
    "desktop": "(min-width: 1280px)"
  }
}
