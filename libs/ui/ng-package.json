{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/ui",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "input": "src/lib",
      "glob": "_comptoir.scss",
      "output": "styles"
    },
    {
      "input": "src/lib",
      "glob": "_patterns.scss",
      "output": "styles"
    }
  ]
}
